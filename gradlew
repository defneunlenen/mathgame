#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#
# Set internal dependencies and java args for for Gradle Tooling Access.
# This is an auto-generated script - do not edit.

appDir=$({
    dir=$(dirname "$0")
    (cd "$dir" && pwd)
}) || exit 1

# Download wrapper jar if needed
gradleWrapperJar="$appDir/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$gradleWrapperJar" ]; then
    # Create a minimal wrapper jar downloader
    exec "$JAVA_HOME/bin/java" \
        -jar /dev/null \
        org.gradle.wrapper.GradleWrapperMain "$@"
fi

# Default to JNI library directory from jpackage
export JAVA_OPTS="${JAVA_OPTS} --add-opens=java.base/java.lang=ALL-UNNAMED"

exec "$JAVA_HOME/bin/java" \
    $DEFAULT_JVM_OPTS \
    $JAVA_OPTS \
    -classpath "$gradleWrapperJar" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
